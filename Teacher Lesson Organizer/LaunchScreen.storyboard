    <scenes>
        <scene sceneID="start-scene">
            <objects>
                <viewController id="start-controller" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="start-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Starting…" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="start-label">
                                <rect key="frame" x="144" y="413" width="105" height="26"/>
                                <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="22"/>
